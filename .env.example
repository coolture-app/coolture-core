# HOSTNAME can be: localhost, IP of Homelab (10.0.0.1) or any other domain/ip
HOSTNAME=10.0.0.1

# HOST PORTS
GARAGE_API_HOST_PORT=3900
GARAGE_ADMIN_HOST_PORT=3910
GARAGE_UI_HOST_PORT=3920
POSTGRES_HOST_PORT=5430
GATEWAY_HOST_PORT=8090
REST_API_HOST_PORT=8091
KEYCLOAK_HOST_PORT=8180
KEYCLOAK_MANAGEMENT_HOST_PORT=8181

# Spring (available profiles: local, dev, homelab)
SPRING_PROFILES_ACTIVE=homelab

# Garage S3 Storage

# Generate secrets for S3 storage
GARAGE_RPC_SECRET="$(openssl rand -hex 32)"
GARAGE_ADMIN_TOKEN="$(openssl rand -hex 32)"
GARAGE_METRICS_TOKEN="$(openssl rand -hex 32)"
GARAGE_ACCESS_KEY_ID="GK$(openssl rand -hex 12)"
GARAGE_ACCESS_KEY_SECRET="$(openssl rand -hex 32)"

# Container hostname
GARAGE_HOSTNAME=s3garage

# Ports in container
GARAGE_RPC_BIND_PORT=3901

# Other
GARAGE_REGION=garage
GARAGE_BUCKET_NAME=coolture-bucket
GARAGE_KEY_NAME=coolture-key

# Keycloak

KEYCLOAK_COOLTURE_SWAGGER_CLIENT_ID=coolture-swagger
KEYCLOAK_COOLTURE_GATEWAY_CLIENT_ID=coolture-gateway
KEYCLOAK_COOLTURE_SWAGGER_CLIENT_SECRET=74in9eNuLAKHEIowc8LheU4CQv3pPx5x
KEYCLOAK_COOLTURE_GATEWAY_CLIENT_SECRET=YsiygIl2YKRzEyTW7UDnio05PpC8yQdJ

KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

KEYCLOAK_HOSTNAME=keycloak

# Postgres

POSTGRES_DB=coolture_db
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin