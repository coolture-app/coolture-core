# Garage S3 Storage

# Secrets: paste the OUTPUT of the openssl commands (Docker does not run $(...) in .env).
# GARAGE_RPC_SECRET MUST be exactly 64 hex characters (32 bytes): run `openssl rand -hex 32`
GARAGE_RPC_SECRET=b117cfdc4faecf206c9749db04981649555bb42476a58335f9f86ec61776e5be
GARAGE_ADMIN_TOKEN=8ef72871c961603710379d86e6a372706d95154f51b38615842cc38cc005f577
GARAGE_METRICS_TOKEN=4ea59159f602cde9f9ecccef5408557f875e38a72bb8a2796ea014c23d6b27f2
GARAGE_ACCESS_KEY_ID=GKd15b758b266130e5f3425cfa
GARAGE_ACCESS_KEY_SECRET=a8d7da1a9f0ce7f6ab5470f69e1c4aa9c7a584e7461102dda6fca2daa3d423a9

# Container hostname
GARAGE_HOSTNAME=s3garage

# Ports on host
GARAGE_API_HOST_PORT=3900
GARAGE_ADMIN_HOST_PORT=3910
GARAGE_UI_HOST_PORT=3920

# Ports in container
GARAGE_RPC_BIND_PORT=3901

# Other
GARAGE_REGION=garage
GARAGE_BUCKET_NAME=coolture-bucket
GARAGE_KEY_NAME=coolture-key

# Keycloak

KEYCLOAK_COOLTURE_SWAGGER_CLIENT_ID=coolture-swagger
KEYCLOAK_COOLTURE_GATEWAY_CLIENT_ID=coolture-gateway
KEYCLOAK_COOLTURE_SWAGGER_CLIENT_SECRET=secret
KEYCLOAK_COOLTURE_GATEWAY_CLIENT_SECRET=secret

KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

KEYCLOAK_HOSTNAME=keycloak
KEYCLOAK_PORT=8180
KEYCLOAK_MANAGEMENT_PORT=8181

# Public HTTP hostname (nginx server_name, OAuth, Keycloak URLs). Example: coolture-dev.duckdns.org
COOLTURE_PUBLIC_HOST=coolture-dev.duckdns.org
# docker-compose-deploy: gateway→API uses GATEWAY_REST_API_URI (app:8081). These are only for local/non-compose runs.
# COOLTURE_GATEWAY_BACKEND_HOST=localhost
# COOLTURE_GATEWAY_S3_HOST=localhost

# --- docker-compose-deploy.yml + nginx (HTTP only: http://$COOLTURE_PUBLIC_HOST/ on NGINX_HTTP_PORT) ---
NGINX_HTTP_PORT=80
GATEWAY_HOST_PORT=80
# After login, redirect to SPA on the same public port (80 with nginx; use 4000 only if you publish the SPA directly).
COOLTURE_FRONTEND_PORT=80

COOLTURE_NG_SERVE_PORT=4200
REST_API_HOST_PORT=8081

# Host port for Postgres (container stays on 5432; app uses postgres:5432 on the Docker network)
POSTGRES_HOST_PORT=5433
POSTGRES_DB=coolture_db
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin

# Spring

SPRING_PROFILES_ACTIVE=dev
